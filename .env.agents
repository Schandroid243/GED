# ── Redis ──────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# ── MySQL ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=abc@12345
DB_NAME=ged_db
DB_SYNCHRONIZE=false
DB_LOGGING=false
DATABASE_MIGRATIONS_RUN=true

# ── Stockage local (système de fichiers) ───────────
LOCAL_STORAGE_ROOT=/Users/schadrack/ged/storage
LOCAL_STORAGE_ARCHIVE=/Users/schadrack/ged/archive
LOCAL_STORAGE_PUBLIC_URL=http://localhost:3000/files

# ── Concurrency par agent ──────────────────────────
OCR_CONCURRENCY=1
CLASSIFICATION_CONCURRENCY=4
INDEXING_CONCURRENCY=2
WORKFLOW_CONCURRENCY=1
NOTIFICATION_CONCURRENCY=5
ARCHIVE_CONCURRENCY=2
INGESTION_CONCURRENCY=2

# ── Chemins système ────────────────────────────────
TESSERACT_PATH=/usr/bin/tesseract
LIBREOFFICE_PATH=/usr/bin/soffice
GHOSTSCRIPT_PATH=/usr/bin/gs
CLAMDSCAN_PATH=/usr/bin/clamdscan
UPLOAD_TEMP_DIR=/tmp/uploads

# ── Feature flags ──────────────────────────────────
AGENT_OCR_ENABLED=true
AGENT_ML_CLASSIFICATION=false
AGENT_ARCHIVE_ENABLED=true

# ── BullBoard ──────────────────────────────────────
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=changeme

# ── Alertes ────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
QUEUE_DEPTH_ALERT_THRESHOLD=500

# ── SMTP (notifications email) ─────────────────────
SMTP_HOST=smtp.prod.internal
SMTP_PORT=587
SMTP_USER=ged@prod.internal
SMTP_PASS=changeme

# ── API ────────────────────────────────────────────
API_PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=a1b2c3d4e5f6071829a0b1c2d3e4f50617283940a1b2c3d4e5f6071829a0b1c
JWT_EXPIRES_IN=8h
